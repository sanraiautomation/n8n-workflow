          "assignments": [
            {
              "id": "5fbd544c-c329-4148-97b9-7e0d0569dc43",
              "name": "prompt",
              "value": "=A realistic baby aged 0–6 months is lying flat on their back, wearing the exact same dress shown in the input image. The full dress must remain completely visible at all times with no cropping or occlusion. The baby has a soft, gentle, natural smile, with a calm and pleasant facial expression maintained throughout the video. Use a front-facing camera angle only, with a stable camera, no zoom, no rotation, and no camera movement. The composition is centered and product-focused. Lighting is soft, warm, and natural, with a clean, minimal background and a photorealistic, high-quality texture. No stylization, filters, or artistic effects. Baby movement is extremely subtle, limited to slow, smooth, gentle hand movements and small, happy baby gestures, with minimal, fully natural body motion. Strictly no standing, sitting, walking, turning, sudden movements, head shaking, excessive arm or leg motion, tongue out, talking, lip-sync, mouth animation, or exaggerated facial expressions. Dress integrity is critical: the dress color, texture, pattern, and fit must remain exactly the same as the input image, with no distortion, color shift, or fabric changes, and it must look identical throughout. Audio should be soft, joyful baby background music only, with no vocals, no speech, and no sound effects tied to mouth movement. The overall goal is a warm, cute, realistic, minimal-motion product video ideal for Instagram and TikTok baby clothing advertisements, with maximum focus on the dress and the baby’s natural charm.",
              "type": "string"
            },
            {
              "id": "91dd5f9e-8efd-44d3-88a0-1f82af105402",
              "name": "image",
              "value": "={{ $json.base64Image }}",
