    {
      "parameters": {
        "jsCode": "// If your OpenAI output is already an object, use it directly\nlet data = $input.first().json.output[0].content[0].text;\n\n// If the output is a string (common in OpenAI nodes), parse it\nif (typeof data === 'string') {\n  data = JSON.parse(data);\n}\n\n// If the JSON is stored under a specific field (adjust if needed)\n// Example: items[0].json.output\nif (data.output && typeof data.output === 'string') {\n  data = JSON.parse(data.output);\n}\n\nreturn [\n  {\n    json: {\n      title: data.title,\n      outline: data.outline,\n      article: data.article\n    }\n  }\n];\n"
      },
